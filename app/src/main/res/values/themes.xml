<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Everything visible is drawn by Compose from the token files; this only
         keeps the system from drawing an action bar or a white window first. -->
    <style name="Theme.AudioFool" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
